# Keep line endings identical on every platform. Without this, a contributor on
# Windows (where core.autocrlf defaults to true) regenerates pages with CRLF and
# every build shows up as a whole-file diff.
* text=auto eol=lf

# Binary assets: never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text eol=lf
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
